{
    "name": "cartalyst/conditions",
    "description": "A framework agnostic conditions package that allows you to apply conditions on Illuminate Collections.",
    "keywords": [
        "php",
        "cartalyst",
        "laravel",
        "collection",
        "condition"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "Cartalyst LLC",
            "email": "help@cartalyst.com",
            "homepage": "https://cartalyst.com"
        }
    ],
    "require": {
        "php": ">=5.4.0",
        "cartalyst/collections": "~1.0",
        "jeremeamia/superclosure": "~2.0"
    },
    "require-dev": {
        "cartalyst/php-cs-fixer-config": "^1.0",
        "mockery/mockery": "~0.9",
        "phpunit/phpunit": "~4.5",
        "pimple/pimple": "~3.0"
    },
    "autoload": {
        "psr-4": {
            "Cartalyst\\Conditions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cartalyst\\Conditions\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "component": "package",
        "branch-alias": {
            "dev-master": "2.0.x-dev"
        }
    },
    "minimum-stability": "stable"
}
